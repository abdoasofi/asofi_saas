{
 "name": "Managed Company",
 "module": "Asofi SaaS",
 "doctype": "DocType",
 "engine": "InnoDB",
 "autoname": "field:site_name",
 "naming_rule": "By fieldname",
 "title_field": "company_name",
 "fields": [
  {
   "fieldname": "company_name",
   "fieldtype": "Data",
   "label": "Company Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "site_name",
   "fieldtype": "Data",
   "label": "Site Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "description": "The Frappe site name on the bench (e.g. acme.rased.com). Unique key."
  },
  {
   "fieldname": "site_url",
   "fieldtype": "Data",
   "label": "Site URL",
   "reqd": 1,
   "description": "Reachable base URL for pushing subscriptions (e.g. https://acme.rased.com)."
  },
  {
   "fieldname": "custom_domain",
   "fieldtype": "Data",
   "label": "Custom Domain",
   "description": "Optional vanity domain for the SSL certificate (defaults to the site name)."
  },
  {
   "fieldname": "control_plane_secret",
   "fieldtype": "Password",
   "label": "Control Plane Secret",
   "description": "Shared secret; must equal this site's site_config rased_control_plane_secret."
  },
  {
   "fieldname": "subscription_section",
   "fieldtype": "Section Break",
   "label": "Subscription"
  },
  {
   "fieldname": "subscription_plan",
   "fieldtype": "Link",
   "label": "Subscription Plan",
   "options": "SaaS Subscription Plan",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "subscription_status",
   "fieldtype": "Select",
   "label": "Subscription Status",
   "options": "Trial\nActive\nExpired\nSuspended",
   "default": "Trial",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_sub",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "subscription_start",
   "fieldtype": "Date",
   "label": "Subscription Start"
  },
  {
   "fieldname": "subscription_end",
   "fieldtype": "Date",
   "label": "Subscription End"
  },
  {
   "fieldname": "contact_section",
   "fieldtype": "Section Break",
   "label": "Contact"
  },
  {
   "fieldname": "contact_person",
   "fieldtype": "Data",
   "label": "Contact Person"
  },
  {
   "fieldname": "contact_phone",
   "fieldtype": "Data",
   "label": "Contact Phone",
   "options": "Phone"
  },
  {
   "fieldname": "column_break_contact",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "contact_email",
   "fieldtype": "Data",
   "label": "Contact Email",
   "options": "Email"
  },
  {
   "fieldname": "status_section",
   "fieldtype": "Section Break",
   "label": "Provisioning & Push"
  },
  {
   "fieldname": "provision_status",
   "fieldtype": "Select",
   "label": "Provision Status",
   "options": "Draft\nQueued\nCreating\nActive\nFailed",
   "default": "Draft",
   "in_standard_filter": 1
  },
  {
   "fieldname": "last_push_on",
   "fieldtype": "Datetime",
   "label": "Last Push On",
   "read_only": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_push_status",
   "fieldtype": "Select",
   "label": "Last Push Status",
   "options": "\nSuccess\nFailed",
   "read_only": 1
  },
  {
   "fieldname": "last_push_error",
   "fieldtype": "Small Text",
   "label": "Last Push Error",
   "read_only": 1
  },
  {
   "fieldname": "usage_section",
   "fieldtype": "Section Break",
   "label": "Usage (synced from site)"
  },
  {
   "fieldname": "usage_collectors",
   "fieldtype": "Int",
   "label": "Collectors (active)",
   "read_only": 1
  },
  {
   "fieldname": "usage_zones",
   "fieldtype": "Int",
   "label": "Zones",
   "read_only": 1
  },
  {
   "fieldname": "usage_beneficiaries",
   "fieldtype": "Int",
   "label": "Beneficiaries",
   "read_only": 1
  },
  {
   "fieldname": "column_break_usage",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "usage_beneficiaries_active",
   "fieldtype": "Int",
   "label": "Beneficiaries (active)",
   "read_only": 1
  },
  {
   "fieldname": "usage_branches",
   "fieldtype": "Int",
   "label": "Branches",
   "read_only": 1
  },
  {
   "fieldname": "usage_employees",
   "fieldtype": "Int",
   "label": "Employees",
   "read_only": 1
  },
  {
   "fieldname": "usage_incidents_open",
   "fieldtype": "Int",
   "label": "Open Incidents",
   "read_only": 1
  },
  {
   "fieldname": "usage_violations",
   "fieldtype": "Int",
   "label": "Violations",
   "read_only": 1
  },
  {
   "fieldname": "usage_messages_30d",
   "fieldtype": "Int",
   "label": "Messages (30d)",
   "read_only": 1
  },
  {
   "fieldname": "usage_ai_tokens",
   "fieldtype": "Int",
   "label": "AI Tokens (this month)",
   "read_only": 1
  },
  {
   "fieldname": "usage_ai_calls",
   "fieldtype": "Int",
   "label": "AI Calls (this month)",
   "read_only": 1
  },
  {
   "fieldname": "usage_ocr_reads",
   "fieldtype": "Int",
   "label": "Meter OCR Reads (30d)",
   "read_only": 1
  },
  {
   "fieldname": "usage_last_activity",
   "fieldtype": "Date",
   "label": "Last Activity",
   "read_only": 1
  },
  {
   "fieldname": "usage_synced_on",
   "fieldtype": "Datetime",
   "label": "Usage Synced On",
   "read_only": 1
  },
  {
   "fieldname": "usage_error",
   "fieldtype": "Small Text",
   "label": "Usage Sync Error",
   "read_only": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "signup_section",
   "fieldtype": "Section Break",
   "label": "Signup"
  },
  {
   "fieldname": "is_trial",
   "fieldtype": "Check",
   "label": "Self-service Trial",
   "default": "0",
   "read_only": 1,
   "in_standard_filter": 1,
   "description": "Set when the site was created by a visitor via the public /asofisaas trial form."
  },
  {
   "fieldname": "requested_plan",
   "fieldtype": "Link",
   "label": "Plan the Visitor Asked About",
   "options": "SaaS Subscription Plan",
   "read_only": 1,
   "in_standard_filter": 1,
   "description": "What the visitor clicked on the pricing page. A sales signal only — it never grants anything; the trial always runs on SaaS Settings.trial_plan."
  },
  {
   "fieldname": "signup_ip",
   "fieldtype": "Data",
   "label": "Signup IP",
   "read_only": 1,
   "description": "IP address that submitted the public trial form (audit trail)."
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "report": 1
  }
 ]
}
